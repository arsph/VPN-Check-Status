{
  "rewrites": [
    {
      "source": "/login",
      "destination": "https://api2.benzorango.net/login"
    },
    {
      "source": "/panel/api/inbounds/getClientTraffics/:user",
      "destination": "https://api2.benzorango.net/panel/api/inbounds/getClientTraffics/:user"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        }
      ]
    }
  ]
} 